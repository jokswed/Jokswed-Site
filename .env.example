# =============================================================================
# JOKSWED — VARIABLES D'ENVIRONNEMENT
# -----------------------------------------------------------------------------
# Copier en .env.local pour le développement, et déclarer les mêmes clés dans
# Vercel → Settings → Environment Variables pour la production.
#
# ⚠️ LE ZIP LIVRÉ N'AVAIT AUCUN FICHIER D'EXEMPLE, et le README n'évoquait
#    aucune variable. Un déploiement neuf partait donc avec un formulaire muet :
#    la route répondait « Le service d'envoi n'est pas encore configuré » sans
#    que rien n'indique quoi configurer.
# =============================================================================

# --- Adresse publique du site -------------------------------------------------
# Sert à la vérification d'origine de /api/contact ET aux URL absolues du SEO.
# Sans elle, la route refuse toutes les soumissions (403) hors aperçu Vercel.
SITE_URL=https://jokswed.com

# --- Acheminement des e-mails -------------------------------------------------
# Les trois sont OBLIGATOIRES. Il n'y a plus d'expéditeur de repli : la version
# précédente retombait sur « onboarding@resend.dev », donc sur un domaine qui
# n'est pas celui de JoksWed, avec un échec d'authentification probable.
# Désormais, une configuration incomplète renvoie une erreur franche.
RESEND_API_KEY=re_votre_cle
CONTACT_TO_EMAIL=jokswed@gmail.com
# L'adresse d'expédition doit appartenir à un domaine vérifié chez le
# fournisseur (DKIM configuré), sans quoi les e-mails partiront en indésirables.
CONTACT_FROM_EMAIL=JoksWed <contact@jokswed.com>

# =============================================================================
# PRÉVU POUR LES VERSIONS SUIVANTES — NE PAS RENSEIGNER MAINTENANT
# =============================================================================
# V3 — base de données JoksWed (Neon), distincte de celle d'EyesofJoks
# DATABASE_URL=
# V3 — rôle applicatif soumis au RLS : ni propriétaire, ni BYPASSRLS
# DATABASE_URL_APP=
# V8 — envoi via Brevo, en remplacement de Resend
# BREVO_API_KEY=
# V9 — réception des réponses par Gmail, scope gmail.readonly uniquement
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# V10 — notifications push iPhone
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=

# --- V3 : base JoksWed et secrets ---------------------------------------------
# ⚠️ CETTE CHAÎNE DOIT PORTER LE RÔLE `jokswed_app`, JAMAIS LE PROPRIÉTAIRE.
#    Le propriétaire des tables contourne les politiques RLS : s'y connecter
#    désactiverait silencieusement tout le cloisonnement entre entreprises.
#    Un banc le vérifie à chaque exécution (`npm run test:securite`).
DATABASE_URL_APP=postgres://jokswed_app:MOT_DE_PASSE@HOTE/jokswed
# Réservée aux migrations, exécutées à la main. Jamais dans l'application.
DATABASE_URL_MIGRATEUR=postgres://jokswed_migrateur:MOT_DE_PASSE@HOTE/jokswed
# 32 octets en base64 : openssl rand -base64 32
# Chiffre les graines TOTP au repos. Sans elle, l'application refuse de démarrer
# ces fonctions plutôt que de stocker un secret en clair.
JOKSWED_CHIFFREMENT_CLE=
# ⚠️ RÔLE SÉPARÉ POUR LE SEUL CHEMIN DE CONNEXION (palier 008).
#    `jokswed_auth` n'a AUCUN privilège de table : il ne peut qu'appeler les
#    fonctions d'authentification. C'est ce qui empêche une injection dans une
#    requête métier de se forger une session de propriétaire.
DATABASE_URL_AUTH=postgres://jokswed_auth:MOT_DE_PASSE@HOTE/jokswed

# --- V4.1 : e-mails Brevo et file périodique ----------------------------------
# ⚠️ MÊME COMPTE BREVO QUE EYESOFJOKS, EXPÉDITEUR DISTINCT.
#    Brevo accepte plusieurs expéditeurs vérifiés et plusieurs domaines
#    authentifiés sur un même compte. Rien ici ne touche la configuration
#    existante d'EyesofJoks.
BREVO_API_KEY=
JOKSWED_EMAIL_EXPEDITEUR=contact@jokswed.com
JOKSWED_EMAIL_NOM=JoksWed
# "simule" = boîte en mémoire, aucun envoi réel. Utilisé par les bancs.
EMAIL_FOURNISSEUR=
# 1 = rien ne part, même avec une clé valide.
EMAIL_DRY_RUN=
# Protège /api/cron/drain. Sans lui, l'endpoint répond 503 au lieu de s'ouvrir.
CRON_SECRET=
